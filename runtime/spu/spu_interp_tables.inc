    case 0x78: return SPU_roti;
    case 0x79: return SPU_rotmi;
    case 0x7A: return SPU_rotmai;
    case 0x7B: return SPU_shli;
    case 0x7C: return SPU_rothi;
    case 0x7D: return SPU_rothmi;
    case 0x7E: return SPU_rotmahi;
    case 0x7F: return SPU_shlhi;
    case 0x1F4: return SPU_cbd;
    case 0x1F5: return SPU_chd;
    case 0x1F6: return SPU_cwd;
    case 0x1F7: return SPU_cdd;
    case 0x1F8: return SPU_rotqbii;
    case 0x1F9: return SPU_rotqmbii;
    case 0x1FB: return SPU_shlqbii;
    case 0x1FC: return SPU_rotqbyi;
    case 0x1FD: return SPU_rotqmbyi;
    case 0x1FF: return SPU_shlqbyi;
    default: return SPU_word;
    }
}

static spu_op spu_dec_lsx(uint32_t op11) {
    switch (op11) {
    case 0x144: return SPU_stqx;
    case 0x1C4: return SPU_lqx;
    default: return SPU_word;
    }
}

/* signed-vs-unsigned i7 per instruction (Table 2-6) */
static int spu_ri7_unsigned(spu_op op) {
    return op == SPU_cbd || op == SPU_cdd || op == SPU_chd || op == SPU_cwd;
}
