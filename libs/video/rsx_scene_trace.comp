vec3 guideNormal(uint index){return vec3(uintBitsToFloat(ao.value[pixelCount()*3u+index]),uintBitsToFloat(ao.value[pixelCount()*4u+index]),uintBitsToFloat(ao.value[pixelCount()*5u+index]));}
