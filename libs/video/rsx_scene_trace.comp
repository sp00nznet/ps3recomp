        if(!rsx_pt_internal_unit(n,normal)){atomicOr(validity.flags,16u);return 0.0;}
        if(dot(normal,direction)>0.0)normal=-normal;
        vec3 nextThroughput,nextOrigin;
        if(!rsx_pt_diffuse_step(throughput,vec3(.65),nextThroughput) ||
           !rsx_pt_offset(origin+direction*distance,normal,p.settings.y,nextOrigin)){
            atomicOr(validity.flags,16u);return 0.0;
        }
        throughput=nextThroughput;origin=nextOrigin;
