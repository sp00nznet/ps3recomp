// Three spatial a-trous passes filter only stochastic transport. Texture color
// and alpha are never blurred. Current-frame depth and hit normals reject
// discontinuities; no temporal history, fabricated motion or NVIDIA RR claim.
void filterTransport(uvec2 pixel){
    if((RSX_TRANSPORT_FLAGS&32u)!=0u){hybridFilter(pixel);return;}
    uint index=pixel.y*p.dims.x+pixel.x,n=pixelCount();
    uint source=phase.mode==2u?0u:phase.mode==3u?1u:2u;
    uint destination=phase.mode==3u?2u:1u;
    float center=uintBitsToFloat(ao.value[source*n+index]);
    float depth=guideDepth(index);vec3 normal=guideNormal(index);
    if((atomicOr(validity.flags,0u)&~2u)!=0u || depth<=0.0){ao.value[destination*n+index]=floatBitsToUint(center);return;}
    vec3 point=guidePosition(pixel,depth);
    int stepSize=1<<int(phase.mode-2u);
    const float kernel[5]=float[5](1,4,6,4,1);
    float sum=0.0,weightSum=0.0;
    for(int y=-2;y<=2;y++)for(int x=-2;x<=2;x++){
        ivec2 q=ivec2(pixel)+ivec2(x,y)*stepSize;
        if(any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,ivec2(p.dims.xy))))continue;
