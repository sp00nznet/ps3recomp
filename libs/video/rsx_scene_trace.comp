    float z=texelFetch(rasterDepth,ivec2(pixel),0).r;
    if(z>=1.0)return 0.0;
    float depth=p.projection.w/(z-p.projection.z);
    if(isnan(depth)||isinf(depth)||depth<=0.0)return 0.0;
    float sampleOffset=p.counts.z==2u?(pixel.x%2u==0u?.75:.25):.5;
    vec2 uv=(vec2(pixel/uvec2(p.counts.z,1))+sampleOffset)/vec2(p.dims.zw);
