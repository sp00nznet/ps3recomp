void main(){
    uvec2 pixel=gl_GlobalInvocationID.xy;
    if(phase.mode==0u){if(all(lessThan(pixel,p.dims.xy)))tracePixel(pixel);return;}
    if(phase.mode==5u){
        if(all(equal(pixel,uvec2(0)))){
            uint primary=ao.value[statsBase()],matched=ao.value[statsBase()+1u];
            // At most 0.1% (minimum two samples) may fall back locally. This
            // keeps gross projection/geometry corruption a whole-frame reject.
            if((RSX_TRANSPORT_FLAGS&32u)==0u && primary-matched>max(2u,primary/1000u))atomicOr(validity.flags,8u);
        }
        return;
    }
    // Hybrid only: 7 smooths the sky estimate before tracing, 6 accumulates
    // the filtered lighting over time before the composite reads it.
    if(phase.mode==7u){if(all(equal(pixel,uvec2(0))))hybridSkyUpdate();return;}
    if(phase.mode==6u){if(all(lessThan(pixel,p.dims.xy)))hybridTemporal(pixel);return;}
    // 8: hybrid late composite (asynchronous transport); 1: composite.
    if(phase.mode>=2u && phase.mode!=8u){if(all(lessThan(pixel,p.dims.xy)))filterTransport(pixel);return;}
    uvec2 expanded=uvec2(p.dims.z*p.counts.z,p.dims.w);
    if(any(greaterThanEqual(pixel,expanded)))return;
    vec4 original=texelFetch(worldColor,ivec2(pixel),0);
    vec4 raw=original;
    // A separate dispatch and shader-write/read barrier make EVERY trace's
    // validity writes visible before ANY color is selected. Sparse unmatched
    // samples retain original color; invalid scenes reject the entire pass.
    // Hybrid composites even a rejected frame: its temporal pass already
    // replaced that frame's lighting with the reprojected previous result.
    if((RSX_TRANSPORT_FLAGS&32u)!=0u){
        if(phase.mode==8u)hybridLateComposite(pixel,original,raw);
        else hybridComposite(pixel,original,raw);
    }else if((validity.flags&~2u)==0u && (RSX_TRANSPORT_FLAGS&4u)!=0u){
        uint index=pixel.y*p.dims.x+pixel.x;vec3 delta;
        for(uint c=0u;c<3u;c++)delta[c]=uintBitsToFloat(ao.value[pixelCount()*(7u+c)+index]);
        original.rgb=clamp(original.rgb+delta,vec3(0),vec3(1));raw=original;
    }else if((validity.flags&~2u)==0u){
        uvec2 a=min(uvec2(vec2(pixel/uvec2(p.counts.z,1))*vec2(p.dims.xy)/vec2(p.dims.zw)),p.dims.xy-1);
        float rawTransport=uintBitsToFloat(ao.value[a.y*p.dims.x+a.x]);
        raw.rgb*=1-p.settings.z*rawTransport;
        float filtered=(RSX_TRANSPORT_FLAGS&2u)!=0u?upsampleTransport(pixel,a):rawTransport;
        original.rgb*=1-p.settings.z*filtered;
    }
    imageStore(rawColor,ivec2(pixel),raw);
    imageStore(outputColor,ivec2(pixel),original);
}
