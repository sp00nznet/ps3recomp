        if(rayQueryGetIntersectionTypeEXT(q,true)!=gl_RayQueryCommittedIntersectionTriangleEXT)return 1.0-transmittance;
        float coverage;
        if(!hitAlpha(rayQueryGetIntersectionPrimitiveIndexEXT(q,true),rayQueryGetIntersectionBarycentricsEXT(q,true),direction,coneRadius+rayQueryGetIntersectionTEXT(q,true)*coneSpread,coverage)){
            atomicOr(validity.flags,4u);return 0.0;
        }
        transmittance*=1.0-coverage;
        if(transmittance<=.001)return 1.0-transmittance;
        float distance=rayQueryGetIntersectionTEXT(q,true);
