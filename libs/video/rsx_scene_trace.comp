    // Closest accepted layers avoid counting duplicated coplanar raster
    // passes twice. The distance epsilon and finite layer budget are explicit
    // AO approximation limits; exhausting the budget invalidates the epoch.
    for(uint layer=0;layer<32u;layer++){
        rayQueryEXT q;rayQueryInitializeEXT(q,scene,0,255,origin,minimum,direction,p.settings.x);
        while(rayQueryProceedEXT(q)){
            if(rayQueryGetIntersectionTypeEXT(q,false)!=gl_RayQueryCandidateIntersectionTriangleEXT){atomicOr(validity.flags,4u);continue;}
            float coverage;
            if(hitAlpha(rayQueryGetIntersectionPrimitiveIndexEXT(q,false),rayQueryGetIntersectionBarycentricsEXT(q,false),direction,coneRadius+rayQueryGetIntersectionTEXT(q,false)*coneSpread,coverage))
