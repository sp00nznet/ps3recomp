bool finite3(vec3 v){return !any(isnan(v)) && !any(isinf(v));}
uint pathHash(uint x){x^=x>>16;x*=0x7feb352du;x^=x>>15;x*=0x846ca68bu;x^=x>>16;return x;}
float pathRandom(inout uint state){state=pathHash(state+0x9e3779b9u);return float(state>>8)*(1.0/16777216.0);}
// Experimental diffuse environment transport. Primary authored color stays in
// the game's raster path. Secondary surfaces have an explicit neutral 0.65
// reflectance, not guessed game PBR materials. No screen-space ray marching.
float pathEnvironment(vec3 origin,vec3 normal,float coneRadius,float coneSpread,inout uint state){
    vec3 throughput=vec3(1.0);
    for(uint bounce=0u;bounce<4u;bounce++){
        vec3 direction;float pdf;
        float u=pathRandom(state),v=pathRandom(state);
        if(!rsx_pt_cosine_sample(normal,u,v,direction,pdf)){atomicOr(validity.flags,16u);return 0.0;}
        countRay(2);
        rayQueryEXT q;rayQueryInitializeEXT(q,scene,0,255,origin,0.0,direction,10000.0);
        while(rayQueryProceedEXT(q)){
            if(rayQueryGetIntersectionTypeEXT(q,false)!=gl_RayQueryCandidateIntersectionTriangleEXT){atomicOr(validity.flags,4u);continue;}
            float coverage;
            uint primitive=rayQueryGetIntersectionPrimitiveIndexEXT(q,false);
            vec2 bary=rayQueryGetIntersectionBarycentricsEXT(q,false);
            if(hitAlpha(primitive,bary,direction,coneRadius+rayQueryGetIntersectionTEXT(q,false)*coneSpread,coverage)){
                // Stable stochastic coverage per candidate/path, independent of
                // implementation-defined traversal order. Unknown alpha rejects.
                // Intersection distance changes by subpixel amounts during
                // movement. Hashing its float bits made coverage jump randomly.
                uint coverageKey=pathHash(state^pathHash(primitive+0x85ebca6bu));
                if(float(coverageKey>>8)*(1.0/16777216.0)<coverage)rayQueryConfirmIntersectionEXT(q);
