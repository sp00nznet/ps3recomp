#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(std430,set=0,binding=1) readonly buffer Triangles { float v[]; } triangles;
layout(std430,set=0,binding=2) writeonly buffer Output { vec4 value[]; } result;
layout(push_constant) uniform Parameters {
    uint width; uint height; float sx; float sy;
    uint samples; float distance; float bias; uint ao;
} p;
// Deterministic Hammersley cosine hemisphere: u=(i+.5)/N, v=radicalInverse2(i).
// The same sequence is used at every pixel, with no stochastic temporal state.
float radicalInverse2(uint i) {
    i=(i<<16)|(i>>16);
    i=((i&0x55555555u)<<1)|((i&0xaaaaaaaau)>>1);
    i=((i&0x33333333u)<<2)|((i&0xccccccccu)>>2);
    i=((i&0x0f0f0f0fu)<<4)|((i&0xf0f0f0f0u)>>4);
    i=((i&0x00ff00ffu)<<8)|((i&0xff00ff00u)>>8);
    return float(i)*2.3283064365386963e-10;
}
float occlusion(vec3 point, vec3 normal) {
    vec3 tangent=normalize(cross(abs(normal.z)<0.999?vec3(0,0,1):vec3(0,1,0),normal));
    vec3 bitangent=cross(normal,tangent);
    uint blocked=0;
    for(uint i=0;i<p.samples;i++) {
        float u=(float(i)+0.5)/float(p.samples);
        float phi=6.283185307179586*radicalInverse2(i);
        vec3 local=vec3(sqrt(u)*cos(phi),sqrt(u)*sin(phi),sqrt(1.0-u));
        vec3 direction=normalize(tangent*local.x+bitangent*local.y+normal*local.z);
        rayQueryEXT secondary;
        // Opaque, double-sided geometry: no alpha, material, or transmission data.
        rayQueryInitializeEXT(secondary,scene,gl_RayFlagsOpaqueEXT|gl_RayFlagsTerminateOnFirstHitEXT,
                             0xff,point+normal*p.bias,0.0,direction,p.distance);
        while(rayQueryProceedEXT(secondary)) {}
        if(rayQueryGetIntersectionTypeEXT(secondary,true)==gl_RayQueryCommittedIntersectionTriangleEXT) blocked++;
    }
    return float(blocked)/float(p.samples);
}
void main() {
    uvec2 pixel=gl_GlobalInvocationID.xy;
    if(pixel.x>=p.width || pixel.y>=p.height) return;
    vec3 direction=vec3((2.0*(float(pixel.x)+0.5)/float(p.width)-1.0)/p.sx,
                        (1.0-2.0*(float(pixel.y)+0.5)/float(p.height))/p.sy,1.0);
    rayQueryEXT q;
    rayQueryInitializeEXT(q,scene,gl_RayFlagsOpaqueEXT,0xff,vec3(0),0.00001,direction,1.0e30);
    while(rayQueryProceedEXT(q)) {}
    vec4 answer=vec4(0);
    if(rayQueryGetIntersectionTypeEXT(q,true)==gl_RayQueryCommittedIntersectionTriangleEXT) {
        uint i=rayQueryGetIntersectionPrimitiveIndexEXT(q,true)*9;
        vec3 a=vec3(triangles.v[i],triangles.v[i+1],triangles.v[i+2]);
        vec3 b=vec3(triangles.v[i+3],triangles.v[i+4],triangles.v[i+5]);
        vec3 c=vec3(triangles.v[i+6],triangles.v[i+7],triangles.v[i+8]);
        vec3 normal=normalize(cross(b-a,c-a));
        float depth=rayQueryGetIntersectionTEXT(q,true);
        if(p.ao!=0) {
            // Face the camera for the AO hemisphere. Preserve legacy normals in scene mode.
            if(dot(normal,direction)>0) normal=-normal;
            answer=vec4(occlusion(direction*depth,normal),0,0,depth);
        } else answer=vec4(normal,depth);
    }
    result.value[pixel.y*p.width+pixel.x]=answer;
}
